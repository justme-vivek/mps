# Copy this file to backend/.env and replace placeholder values.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

ADMIN_NAME=School Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-development-password
SEED_RESET_PASSWORD=false

IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Optional SMTP settings. Without these in development, OTPs are logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MPS School <you@example.com>"

# Comma-separated browser origins. Native apps do not need an entry.
CORS_ORIGINS=http://localhost:3000
