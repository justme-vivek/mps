{
  "expo": {
    "name": "MPS",
    "slug": "mps",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mps",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2A59"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mps.school"
    },
    "android": {
      "package": "com.mps.school",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2A59"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": ["expo-router"]
  }
}
